# Скопируйте в .env и заполните своими значениями.
# .env не коммитится в репозиторий.
#
# Пример генерации JWT_SECRET (64 байта в base64):
#   openssl rand -base64 64
# Пароли БД и MinIO должны быть длинными случайными строками.

COMPOSE_PROJECT_NAME=caselab-edm
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL
POSTGRES_DB=edm
POSTGRES_USER=edm
POSTGRES_PASSWORD=change-me-db-password
DATABASE_URL=jdbc:postgresql://edm-db:5432/edm
DATABASE_USERNAME=edm
DATABASE_PASSWORD=change-me-db-password

# JWT (обязательно замените)
JWT_SECRET=change-me-base64-secret
JWT_ACCESS_TOKEN_TTL=1h
JWT_REFRESH_TOKEN_TTL=30d

# CORS: через запятую, без пробелов
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# MinIO
MINIO_ACCESS_KEY=change-me-minio-user
MINIO_SECRET_KEY=change-me-minio-password
MINIO_BUCKET=documents
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_PRESIGNED_URL_EXPIRY=15m

# Elasticsearch
ELASTIC_ENDPOINT=http://elasticsearch:9200
ELASTIC_USERNAME=
ELASTIC_PASSWORD=
ELASTIC_REINDEX_ON_STARTUP=false

# Mail. В production Compose переменные MAIL_* обязательны.
# В локальном профиле dev можно оставить пустыми, если уведомления не тестируются.
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=

# OpenAPI
OPENAPI_SERVER_URL=http://localhost:8080/api/v1

# Первичный администратор. Включайте только при первом запуске пустой БД.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
BOOTSTRAP_ADMIN_FIRST_NAME=Администратор
BOOTSTRAP_ADMIN_LAST_NAME=Системы
BOOTSTRAP_ADMIN_POSITION=Administrator
