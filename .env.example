# Copy to .env and replace every placeholder. Never commit .env.
# Generate JWT_SECRET: openssl rand -base64 64

COMPOSE_PROJECT_NAME=caselab-edm
SPRING_PROFILES_ACTIVE=dev

# Backend PostgreSQL
POSTGRES_DB=edm
POSTGRES_USER=edm
POSTGRES_PASSWORD=change-me-backend-db-password
DATABASE_URL=jdbc:postgresql://localhost:5432/edm
DATABASE_USERNAME=edm
DATABASE_PASSWORD=change-me-backend-db-password

# Identity PostgreSQL (separate database and credentials)
SECURITY_POSTGRES_DB=security
SECURITY_POSTGRES_USER=security
SECURITY_POSTGRES_PASSWORD=change-me-security-db-password
SECURITY_DATABASE_URL=jdbc:postgresql://localhost:5433/security
SECURITY_DATABASE_USERNAME=security
SECURITY_DATABASE_PASSWORD=change-me-security-db-password

# Shared JWT secret and service-to-service authentication
JWT_SECRET=change-me-base64-secret
JWT_ACCESS_TOKEN_TTL=1h
JWT_REFRESH_TOKEN_TTL=30d
SECURITY_INTERNAL_TOKEN=change-me-internal-token

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# MinIO
MINIO_ACCESS_KEY=change-me-minio-user
MINIO_SECRET_KEY=change-me-minio-password
MINIO_BUCKET=documents
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_PRESIGNED_URL_EXPIRY=15m

# Elasticsearch
ELASTIC_ENDPOINT=http://localhost:9200
ELASTIC_USERNAME=
ELASTIC_PASSWORD=
ELASTIC_REINDEX_ON_STARTUP=false

# Mail (optional locally, required in production)
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=

# OpenAPI
OPENAPI_SERVER_URL=http://localhost:8080/api/v1

# One-time administrator bootstrap. Disable after the first successful start.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
BOOTSTRAP_ADMIN_FIRST_NAME=Administrator
BOOTSTRAP_ADMIN_LAST_NAME=System
BOOTSTRAP_ADMIN_POSITION=Administrator

# Images used by the production compose on the deployment server
BACKEND_IMAGE=change-me/backend:latest
SECURITY_IMAGE=change-me/security:latest
